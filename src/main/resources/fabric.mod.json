{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "A mod that adds chunk protection that can be stolen by other players.",
  "authors": [
    "Kris HD"
  ],
  "contact": {
    "homepage": ""
  },
  "license": "MIT",
  "icon": "assets/${id}/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "ch.krishd.chunkpermits.fabric.ChunkpermitsFabric"
    ],
    "client": [
      "ch.krishd.chunkpermits.fabric.client.ChunkpermitsFabricClient"
    ]
  },
  "mixins": [
    "chunkpermits.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.4",
    "minecraft": "${minecraft}",
    "java": ">=${java_version}",
